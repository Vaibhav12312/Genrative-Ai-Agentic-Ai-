# Optional source override. Use os.pathsep between multiple paths.
# Windows PowerShell example:
# $env:EPFOSATHI_INPUTS = "..\Day_4\data\records.json;.\data\documents"
# Linux/macOS example:
# export EPFOSATHI_INPUTS="../Day_4/data/records.json:./data/documents"
EPFOSATHI_CHUNK_SIZE=900
EPFOSATHI_CHUNK_OVERLAP=150
EPFOSATHI_EMBED_MODEL=sentence-transformers/all-MiniLM-L6-v2
EPFOSATHI_CHROMA_PATH=./chroma_db
EPFOSATHI_COLLECTION=epfosathi_documents
GEMINI_API_KEY=your_gemini_api_key_here
